# Variables de Entorno para EasyPanel - Sistema CPS
# Copia este archivo como .env y configura los valores

# ========================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ========================================
APP_NAME="CPS License Management System"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://tu-dominio.com
PORT=3000

# ========================================
# BASE DE DATOS MYSQL
# ========================================
# Configura estos valores según tu instancia MySQL en EasyPanel
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=cps_database
DB_USERNAME=cps_user
DB_PASSWORD=cps_secure_2025

# ========================================
# CACHE Y SESIONES (REDIS)
# ========================================
# Configura estos valores según tu instancia Redis en EasyPanel
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# ========================================
# CONFIGURACIÓN DE CORREO
# ========================================
# Configura con tu proveedor de correo SMTP
MAIL_MAILER=smtp
MAIL_HOST=smtp.tu-proveedor.com
MAIL_PORT=587
MAIL_USERNAME=noreply@tu-dominio.com
MAIL_PASSWORD=tu_password_mail
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@tu-dominio.com
MAIL_FROM_NAME="${APP_NAME}"

# ========================================
# INTEGRACIONES DE PAGO
# ========================================
# Configura las claves de Stripe (usar claves de producción)
STRIPE_KEY=pk_live_tu_clave_publica_stripe
STRIPE_SECRET=sk_live_tu_clave_secreta_stripe

# Configuración de PayPal (opcional)
PAYPAL_CLIENT_ID=tu_paypal_client_id
PAYPAL_CLIENT_SECRET=tu_paypal_client_secret
PAYPAL_MODE=live

# ========================================
# CONFIGURACIÓN DE LOGS
# ========================================
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ========================================
# CONFIGURACIÓN DE AWS (opcional)
# ========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ========================================
# CONFIGURACIÓN DE PUSHER (para notificaciones en tiempo real)
# ========================================
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ========================================
# CONFIGURACIÓN ADICIONAL
# ========================================
BROADCAST_DRIVER=log
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
MEMCACHED_HOST=127.0.0.1

# ========================================
# CONFIGURACIÓN DE IONCUBE (ya configurado en Dockerfile)
# ========================================
# No necesitas cambiar nada aquí, ionCube está preconfigurado

# ========================================
# CONFIGURACIÓN DE SEGURIDAD
# ========================================
# APP_KEY se generará automáticamente en el primer inicio
# No compartas el APP_KEY una vez generado

# ========================================
# CONFIGURACIÓN PARA DESARROLLO (cambiar a production en despliegue)
# ========================================
# Broadcasting, queues, cache, sessions, etc. ya configurados arriba